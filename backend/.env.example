# Application
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/rewa_cab

# Redis (for OTP, caching)
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP Settings
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_MINUTES=5
OTP_RATE_LIMIT_COUNT=3

# SMS Gateway (msg91 | twofactor | mock)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=REWACB

# Instamojo Payment Gateway
INSTAMOJO_API_KEY=
INSTAMOJO_AUTH_TOKEN=
INSTAMOJO_BASE_URL=https://test.instamojo.com/api/1.1
INSTAMOJO_WEBHOOK_SECRET=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Firebase (FCM)
FIREBASE_CREDENTIALS_PATH=

# Sentry
SENTRY_DSN=

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

# Booking Settings
SEAT_LOCK_MINUTES=10
BOOKING_TIMEOUT_MINUTES=15
QUOTE_VALIDITY_HOURS=6
